# ==============================================
# PRONOFOOT — Variables d'environnement
# Copiez ce fichier en .env.local puis remplissez
# ==============================================

# --- SUPABASE (OBLIGATOIRE) — Dashboard Supabase > Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique
# Clé service_role (SECRETE — server-side uniquement, jamais exposée au navigateur)
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# --- URL publique du site (redirections emails, liens) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- API-SPORTS / API-FOOTBALL (scores live) — https://dashboard.api-football.com (gratuit : 100 req/jour) ---
API_SPORTS_KEY=

# --- GNEWS (actualités) — https://gnews.io (gratuit : 100 req/jour) ---
# Si vide → fallback automatique sur Google News RSS (gratuit, sans clé)
GNEWS_API_KEY=

# --- GROQ (assistant IA principal) — https://console.groq.com (gratuit) ---
GROQ_API_KEY=
# Modèle Groq à utiliser
GROQ_MODEL=llama-3.1-70b-versatile

# --- GEMINI (assistant IA fallback) — https://aistudio.google.com (gratuit) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- ADMIN ---
# Emails séparés par des virgules qui reçoivent automatiquement les droits admin à l'inscription/connexion
ADMIN_EMAILS=votre-email@exemple.com

# --- CRON (sécurité des routes de synchronisation) ---
# Secret partagé pour autoriser les appels cron externes (cron-job.org, Vercel Cron...)
# Envoyé en header : Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- SYNCHRONISATION ---
# Intervalle minimum (secondes) entre 2 appels réels à API-Sports
# ⚠️ PLAN GRATUIT API-Sports = 100 requêtes/jour → 900 (15 min) est la valeur recommandée.
#    Mettez 90 uniquement si vous passez à un plan payant API-Sports.
#    (Un garde-fou intégré met le site en pause automatiquement si le quota du jour est presque épuisé.)
SCORES_SYNC_INTERVAL=900
# Intervalle minimum (secondes) entre 2 syncs news (600 = 10 minutes)
NEWS_SYNC_INTERVAL=600
